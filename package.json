{
  "name": "relicwake",
  "private": true,
  "version": "0.1.0",
  "description": "Relicwake — idle auto-battle gacha RPG (web + iOS + Android)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @relicwake/api\" \"npm run dev -w @relicwake/web\"",
    "dev:web": "npm run dev -w @relicwake/web",
    "dev:api": "npm run dev -w @relicwake/api",
    "build": "npm run build -w @relicwake/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
